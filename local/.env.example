# Скопіювати у .env і заповнити. Файл .env у git не потрапляє.

# --- Telegram-бот (модуль «Їжа») ---
# Токен від @BotFather. Без нього хаб працює, просто без бота.
TELEGRAM_TOKEN=

# Кому дозволено писати боту: числові id через кому.
# Якщо порожньо — власником стане той, хто перший напише /start.
TELEGRAM_ALLOWED_IDS=

# --- Авто-підказка тегу через Claude (етап 2, необов'язково) ---
ANTHROPIC_API_KEY=
HUB_VISION=1
HUB_VISION_MODEL=claude-opus-5

# --- Сервер ---
HUB_HOST=127.0.0.1
HUB_PORT=8765
# Куди класти базу і фото (за замовчуванням ./data)
HUB_DATA_DIR=
